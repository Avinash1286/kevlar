{
  "name": "kevlar",
  "version": "1.0.0",
  "private": true,
  "description": "Verified live-web intelligence and repair certification",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "baseline:run": "tsx --env-file=.env.local scripts/run-baseline.ts",
    "semantic-swap:run": "tsx --env-file=.env.local scripts/run-semantic-swap.ts",
    "phase3:run": "tsx --env-file=.env.local scripts/run-phase3-reliability.ts",
    "phase4:run": "tsx --env-file=.env.local scripts/run-phase4-core.ts",
    "phase5:collector": "tsx --env-file=.env.local scripts/manage-phase5-collectors.ts",
    "phase5:verify": "tsx --env-file=.env.local scripts/verify-phase5-collector.ts",
    "phase5:run": "tsx --env-file=.env.local scripts/run-phase5-fleet.ts",
    "demo:reset": "tsx --env-file=.env.local scripts/demo-reset.ts",
    "release:benchmark": "tsx --env-file=.env.local scripts/run-release-benchmark.ts",
    "release:e2e": "tsx --env-file=.env.local scripts/run-release-e2e.ts",
    "release:load": "tsx scripts/run-release-load.ts",
    "release:demo": "tsx scripts/record-release-demos.ts",
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @kevlar/web dev",
    "dev:fixture": "pnpm --filter @kevlar/fixture-lab dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && tsc -p convex/tsconfig.json && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy"
  },
  "dependencies": {
    "@convex-dev/auth": "0.0.95",
    "@convex-dev/workflow": "^0.4.6",
    "convex": "^1.27.3",
    "jose": "^6.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.1",
    "convex-test": "0.0.56",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}

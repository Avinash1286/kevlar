{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "source_url",
    "source_type",
    "captured_at",
    "provider",
    "records",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": "ai-infrastructure.source.v1" },
    "source_url": { "type": "string", "format": "uri" },
    "source_type": { "const": "catalog" },
    "captured_at": { "type": "string", "format": "date-time" },
    "provider": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "const": "anthropic" },
        "name": { "const": "Anthropic" }
      },
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "provider_model_id",
          "display_name",
          "family",
          "lifecycle_status",
          "modalities",
          "context_window_tokens",
          "max_output_tokens",
          "capabilities"
        ],
        "properties": {
          "kind": { "const": "model" },
          "provider_model_id": { "type": "string", "minLength": 1 },
          "display_name": { "type": "string", "minLength": 1 },
          "family": { "type": "string", "minLength": 1 },
          "lifecycle_status": {
            "enum": ["preview", "active", "deprecated", "retired", "unknown"]
          },
          "modalities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["text", "image", "audio", "video"] }
          },
          "context_window_tokens": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "max_output_tokens": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "capabilities": {
            "type": "object",
            "required": ["tools", "structured_output", "vision", "audio"],
            "properties": {
              "tools": { "type": "boolean" },
              "structured_output": { "type": "boolean" },
              "vision": { "type": "boolean" },
              "audio": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "page_heading",
        "contexts",
        "screenshot_ref",
        "content_hash"
      ],
      "properties": {
        "page_heading": { "type": "string", "minLength": 1 },
        "contexts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "screenshot_ref": { "type": ["string", "null"] },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
